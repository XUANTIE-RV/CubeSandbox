# riscv64 release-bundle overrides — consume prebuilt `make all-riscv64` artifacts
# (build-release-bundle.sh's build_or_copy_* uses these instead of native builds).
# Source this before invoking build-release-bundle.sh, or use build-release-bundle-riscv64.sh.
ONE_CLICK_ARCH=riscv64
# Stamp the canonical tree version. build-release-bundle.sh derives CUBE_VERSION
# from `git describe --tags` (build-release-bundle.sh:58-59), which is empty in a
# tag-less dev checkout and falls back to 0.0.0-dev. That value lands in
# release-manifest.json as the containerd-shim-cube-rs version, which Cubelet
# reads as the shim pin. A pin below v0.7.2-rc2 (the tree's default image tag and
# Cubelet's minCoordinatedSnapshotShimVersion) forces the legacy best-effort
# app-snapshot capture, whose inconsistent freeze leaves a stale container pid on
# restore ("Exec mount failed: open /proc/<pid>/ns/mnt"). v0.7.2-rc2 selects the
# coordinated single-freeze-window capture the shim already implements.
CUBE_VERSION=v0.7.2-rc2
# --- Go/Rust component binaries (from _output/bin, produced by 'make all-riscv64') ---
ONE_CLICK_CUBEMASTER_BIN=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/bin/cubemaster-riscv64
ONE_CLICK_CUBEMASTERCLI_BIN=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/bin/cubemastercli-riscv64
ONE_CLICK_TEMPLATECENTER_BIN=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/bin/templatecenter-riscv64
ONE_CLICK_CUBELET_BIN=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/bin/cubelet-riscv64
ONE_CLICK_CUBECLI_BIN=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/bin/cubecli-riscv64
ONE_CLICK_CUBE_API_BIN=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/bin/cube-api-riscv64
ONE_CLICK_CUBE_OPS_BIN=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/bin/cubeops-riscv64
ONE_CLICK_CUBE_OPS_CLI_BIN=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/bin/cubeopscli-riscv64
ONE_CLICK_CUBEVSMAPDUMP_BIN=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/bin/cubevsmapdump-riscv64
ONE_CLICK_VOLUME_S3_BIN=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/bin/cube-volume-s3-riscv64
ONE_CLICK_CUBE_AGENT_BIN=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/bin/cube-agent-riscv64
ONE_CLICK_CUBE_INIT_BIN=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/bin/cube-init-riscv64
ONE_CLICK_CUBESHIM_BIN=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/bin/containerd-shim-cube-rs-riscv64
ONE_CLICK_CUBE_RUNTIME_BIN=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/bin/cube-runtime-riscv64
ONE_CLICK_MKCERT_BIN=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/bin/mkcert-riscv64
# --- guest kernel (riscv64 PE Image; PVM n/a on riscv64) ---
ONE_CLICK_CUBE_KERNEL_VMLINUX=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/../cube-l2-assets/vmlinux
ONE_CLICK_GUEST_IMAGE_TAR=/mnt/ssd/workarea/yanan.he/cubesandbox-riscv/_output/guest/cube-guest-image-riscv64.tar.gz
